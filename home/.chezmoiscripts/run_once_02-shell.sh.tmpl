#!/bin/bash
# run_once_02-setup-shell.sh.tmpl
# Installs Zsh as default shell, Oh My Zsh, plugins, and Starship

set -euo pipefail

GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()     { echo -e "${CYAN}[shell]${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}!${NC} $*"; }

#  Set Zsh as default shell ─
if [[ "$SHELL" != "$(which zsh)" ]] && command -v zsh &>/dev/null; then
    log "Setting Zsh as default shell..."
    if grep -q "$(which zsh)" /etc/shells; then
        chsh -s "$(which zsh)"
    else
        echo "$(which zsh)" | sudo tee -a /etc/shells
        chsh -s "$(which zsh)"
    fi
    success "Default shell set to Zsh"
fi

#  Oh My Zsh & Plugins ─
# These are now handled declaratively in .chezmoiexternal.toml.tmpl.
# Chezmoi will automatically download and extract them to:
# - ~/.oh-my-zsh
# - ~/.oh-my-zsh/custom/plugins/

#  Starship ─
# Also handled by .chezmoiexternal.toml.tmpl (installed to ~/.local/bin/starship).

success "Shell setup scripts completed — binaries and plugins are managed by Chezmoi externals."
success "Restart your terminal or run: exec zsh"

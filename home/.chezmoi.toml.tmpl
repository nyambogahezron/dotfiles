# Chezmoi configuration template
# This file is rendered once to generate ~/.config/chezmoi/chezmoi.toml
# Run: chezmoi init --apply gh:nyambogahezron/dotfiles

{{- $name     := promptStringOnce . "name"     "Full name" -}}
{{- $email    := promptStringOnce . "email"    "Personal email" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work email (leave blank if same)" -}}

{{- $machineType := promptStringOnce . "machineType" "Machine type (personal, work, server)" "personal" -}}
{{- $theme       := promptStringOnce . "theme"       "Theme (mocha, macchiato, frappe, latte)" "mocha" -}}

{{- $ageRecipient := "" -}}
{{- if not (env "CI") -}}
{{-   $ageRecipient = promptStringOnce . "ageRecipient" "Age public key for encryption (leave blank to skip)" "" -}}
{{- end -}}

{{- $installPackages := true -}}
{{- $installTools    := true -}}

{{- if not (env "CI") -}}
{{-   $installPackages = promptBoolOnce . "installPackages" "Install core system packages (requires sudo)?" true -}}
{{-   $installTools    = promptBoolOnce . "installTools"    "Install developer tools (lazygit, nvm, node, etc)?" true -}}
{{- end -}}

{{- $enableHyprland := false -}}
{{- $enableKitty    := true -}}
{{- $enableBrew     := false -}}

{{- if eq .chezmoi.os "darwin" -}}
{{-   $enableBrew = true -}}
{{- end -}}

{{- if eq $machineType "personal" -}}
{{-   $enableHyprland = promptBoolOnce . "enableHyprland" "Enable Hyprland config?" -}}
{{- end -}}


[data]
  name         = {{ $name | quote }}
  email        = {{ $email | quote }}
  workEmail    = {{ $workEmail | quote }}
  machineType  = {{ $machineType | quote }}
  runSetup     = true
  installPackages = {{ $installPackages }}
  installTools    = {{ $installTools }}
  enableHyprland = {{ $enableHyprland }}
  enableKitty    = {{ $enableKitty }}
  enableBrew     = {{ $enableBrew }}
  theme          = {{ $theme | quote }}
  ageRecipient   = {{ $ageRecipient | quote }}

{{ if $ageRecipient }}
encryption = "age"
[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = {{ $ageRecipient | quote }}
{{ end }}

[git]
  autoCommit = false
  autoPush   = false

[diff]
  pager = "delta"

[merge]
  command = "nvim"
  args    = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

# Machine-specific git config overrides
# This is included in ~/.gitconfig when machineType is "work"

[user]
    email = {{ index . "workEmail" | default .email }}

[commit]
    # Optional: use a different GPG key for work
    # gpgsign = true
    # signingkey = <WORK_KEY_ID>

[url "git@github.com:work-org/"]
    insteadOf = https://github.com/work-org/

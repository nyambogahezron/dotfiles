# home/.chezmoiexternal.toml.tmpl
# Managed by chezmoi — handles external dependencies and self-updating binaries

# ── Fonts ─────────────────────────────────────────────────────────────────────
{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $fontDir = ".local/share/fonts" }}
{{- end }}

["{{ $fontDir }}/JetBrainsMonoNerdFont-Regular.ttf"]
    type = "file"
    url = "https://github.com/ryanoasis/nerd-fonts/raw/master/patched-fonts/JetBrainsMono/Ligatures/Regular/JetBrainsMonoNerdFont-Regular.ttf"
    refreshPeriod = "168h"

# ── Plugins ───────────────────────────────────────────────────────────────────
[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm"
    refreshPeriod = "168h"

[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-completions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-completions/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# ── Self-Updating Binaries (Linux only, macOS uses Brew) ──────────────────────
{{- if eq .chezmoi.os "linux" }}

{{- $arch := .chezmoi.arch -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $arch = "x86_64" -}}
{{- else if eq .chezmoi.arch "arm64" -}}
{{-   $arch = "aarch64" -}}
{{- end }}

[".local/bin/starship"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "starship/starship" (printf "starship-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
    executable = true
    path = "starship"

[".local/bin/eza"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
    executable = true
    path = "./eza"

[".local/bin/zoxide"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "ajeetdsouza/zoxide" (printf "zoxide-*-%s-unknown-linux-musl.tar.gz" $arch) | quote }}
    executable = true
    path = "zoxide"

[".local/bin/bat"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "sharkdp/bat" (printf "bat-*-x86_64-unknown-linux-gnu.tar.gz") | quote }}
    executable = true
    stripComponents = 1
    path = "bat"

{{- end }}

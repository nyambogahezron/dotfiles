#!/bin/bash
# ~/.local/bin/dot-maintenance
# Automated system maintenance script for dotfiles

GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}=== System Maintenance ===${NC}"

# Update maintenance timestamp
mkdir -p ~/.local/state
date +%s > ~/.local/state/last-maintenance

# Docker cleanup
if command -v docker &>/dev/null && docker info &>/dev/null; then
    echo "Cleaning up Docker..."
    docker system prune -af --volumes
    echo -e "${GREEN}✓ Docker cleaned${NC}"
fi

# Package manager cleanup
if command -v apt-get &>/dev/null; then
    echo "Cleaning up APT..."
    sudo apt-get autoremove -y
    sudo apt-get autoclean -y
    echo -e "${GREEN}✓ APT cleaned${NC}"
fi

if command -v pacman &>/dev/null; then
    echo "Cleaning up pacman..."
    sudo pacman -Sc --noconfirm
    echo -e "${GREEN}✓ Pacman cleaned${NC}"
fi

if command -v brew &>/dev/null; then
    echo "Cleaning up Homebrew..."
    brew cleanup -s
    echo -e "${GREEN}✓ Homebrew cleaned${NC}"
fi

# Systemd journal cleanup
if command -v journalctl &>/dev/null; then
    echo "Cleaning up old logs..."
    sudo journalctl --vacuum-time=7d
    echo -e "${GREEN}✓ Logs cleaned${NC}"
fi

echo -e "${CYAN}Maintenance complete!${NC}"

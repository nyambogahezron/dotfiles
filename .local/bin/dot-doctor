#!/bin/bash
# ~/.local/bin/dot-doctor
# Health check script for dotfiles

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}=== Dotfiles Doctor ===${NC}"

check_cmd() {
    local cmd=$1
    local name=${2:-$1}
    if command -v "$cmd" &>/dev/null; then
        echo -e "${GREEN}✓${NC} $name is installed ($($cmd --version 2>&1 | head -n 1 | awk '{print $1,$2,$3}' | tr -d '\n'))"
    else
        echo -e "${RED}✗${NC} $name is NOT installed or not in PATH"
    fi
}

echo ""
echo -e "${YELLOW}Checking Core Tools...${NC}"
check_cmd nvim "Neovim"
check_cmd tmux "Tmux"
check_cmd zsh "Zsh"
check_cmd stow "GNU Stow"

echo ""
echo -e "${YELLOW}Checking Developer Tools...${NC}"
check_cmd git "Git"
check_cmd lazygit "Lazygit"
check_cmd gh "GitHub CLI"
check_cmd fzf "FZF"
check_cmd rg "Ripgrep"
check_cmd node "Node.js"

echo ""
echo -e "${YELLOW}Checking SSH...${NC}"
if ssh-add -l &>/dev/null; then
    echo -e "${GREEN}✓${NC} SSH keys are loaded in the agent"
else
    echo -e "${RED}✗${NC} No SSH keys loaded (or agent is not running)"
fi

echo ""
echo -e "${CYAN}Diagnosis complete.${NC}"

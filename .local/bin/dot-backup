#!/bin/bash
set -euo pipefail

timestamp=$(date +%Y%m%d-%H%M%S)
backup_dir="$HOME/backups/dotfiles-$timestamp"

mkdir -p "$backup_dir"
rsync -a --exclude ".git" --exclude "node_modules" "$HOME/.config" "$backup_dir/"
rsync -a "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.gitconfig" "$HOME/.tmux.conf" "$HOME/.vimrc" "$backup_dir/" 2>/dev/null || true

echo "Backup saved to $backup_dir"

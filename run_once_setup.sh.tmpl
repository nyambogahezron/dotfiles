#!/bin/bash
# run_once_setup.sh.tmpl
# This is the master setup script that orchestrates the modular scripts in scripts/
# Chezmoi will run this ONCE (or whenever this file or the included scripts change).

set -euo pipefail

#  Header 
echo "Starting Dotfiles Setup..."
echo "OS: {{ .chezmoi.os }} | Machine: {{ .machineType }}"

{{ if not .runSetup -}}
echo "runSetup is false. Skipping setup scripts..."
exit 0
{{- end }}

#  Helper: Run Script 
run_script() {
    local script_name="$1"
    local script_path="{{ .chezmoi.sourceDir }}/scripts/${script_name}"
    
    if [[ -f "$script_path" ]]; then
        echo " Running: ${script_name} "
        # We execute the script using bash. 
        # If the script itself contains templates, we can't just run it directly.
        # So we use chezmoi execute-template to render and run it.
        chezmoi execute-template < "$script_path" | bash
    else
        echo "Script not found: ${script_name}"
    fi
}

#  Execution 

run_script "pkgs.sh"
run_script "shell.sh"
run_script "tools.sh"
run_script "nvim.sh"
run_script "tmux.sh"

echo "Setup complete!"

##############################################################################
# ~/.zshrc — Zsh Configuration
# Managed by dotfiles: github.com/nyambogahezron/dotfiles
##############################################################################

#  Oh My Zsh 

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""   # Using Starship — no OMZ theme needed

plugins=(
    git docker docker-compose npm node python rust golang
    zsh-autosuggestions zsh-syntax-highlighting zsh-completions fzf
)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

#  XDG Base Directories ─

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

#  PATH ──

export PATH="$HOME/.local/bin:$PATH"
export GOPATH="$HOME/go"
export GOROOT="/usr/local/go"
export PATH="$GOPATH/bin:$GOROOT/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.config/composer/vendor/bin:$PATH"

#  Editor 

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

#  NVM (Node Version Manager) ─

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]          && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

#  History ──

mkdir -p "$XDG_STATE_HOME/zsh"
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=50000
SAVEHIST=50000

setopt HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE HIST_FIND_NO_DUPS HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY APPEND_HISTORY

#  Zsh Options ─

setopt AUTO_CD CORRECT EXTENDED_GLOB NOMATCH NOTIFY

#  Completions ─

autoload -Uz compinit
mkdir -p "$XDG_CACHE_HOME/zsh"
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

#  Navigation Aliases 

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

#  ls / eza ─

if command -v eza &>/dev/null; then
    alias ls='eza --color=always --group-directories-first --icons'
    alias ll='eza -alF --color=always --group-directories-first --icons --git'
    alias la='eza -a --color=always --group-directories-first --icons'
    alias l='eza -F --color=always --group-directories-first --icons'
    alias lt='eza -aT --color=always --group-directories-first --icons --level=2'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
    alias lt='ls -ltrh'
fi

alias lx='ls -lXBh'
alias lk='ls -lSrh'
alias lc='ls -ltcrh'
alias lr='ls -lRh'
alias lm='ls -alh | more'
alias lf="ls -l | grep -v '^d'"
alias ldir="ls -l | grep '^d'"

#  bat (better cat) ──

if command -v bat &>/dev/null; then
    alias cat='bat --style=plain'
    alias catn='bat'
elif command -v batcat &>/dev/null; then
    alias cat='batcat --style=plain'
    alias catn='batcat'
fi

#  System Aliases ─

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias cls='clear'
alias c='clear'
alias h='history'
alias j='jobs -l'
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%T"'
alias nowdate='date +"%d-%m-%Y"'
alias da='date "+%Y-%m-%d %A %T %Z"'
alias rmd='rm -rf'
alias ping='ping -c 10'
alias less='less -R'
alias mountedinfo='df -hT'
alias diskspace="du -S | sort -n -r | more"
alias folders='du -h --max-depth=1'
alias ps='ps auxf'
alias p="ps aux | grep "
alias topcpu="/bin/ps -eo pcpu,pid,user,args | sort -k 1 -r | head -10"
alias f="find . | grep "
alias hgrep="history | grep "
command -v btop &>/dev/null && alias top='btop'
command -v dust &>/dev/null && alias du='dust'

# chmod shortcuts
alias mx='chmod a+x'
alias 000='chmod -R 000'
alias 644='chmod -R 644'
alias 755='chmod -R 755'
alias 777='chmod -R 777'

# Archive
alias mktar='tar -cvf'
alias mkgz='tar -cvzf'
alias untar='tar -xvf'
alias ungz='tar -xvzf'

# Network
alias myip='curl -s ifconfig.me && echo'
alias localip='ip -4 addr | grep inet | awk "{print \$2}"'
alias openports='netstat -nape --inet'

# Alert for long running commands
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# System update (multi-package-manager safe)
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && sudo apt autoclean -y \
  ; sudo snap refresh 2>/dev/null ; flatpak update -y 2>/dev/null'
alias install='sudo apt install'
alias remove='sudo apt remove'
alias search='apt search'


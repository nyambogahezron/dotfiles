{
  "folders": [
    {
      "path": ".."
    }
  ],
  "settings": {
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.rulers": [100],
    "search.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/dist": true,
      "**/build": true
    }
  },
  "extensions": {
    "recommendations": [
      "editorconfig.editorconfig",
      "ms-vscode-remote.remote-ssh",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  }
}

    "@emotion/styled": "^11.14.0",
    "@graphql-tools/schema": "^10.0.23",
    "@mui/material": "^6.4.11",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@types/pdfkit": "^0.13.9",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",

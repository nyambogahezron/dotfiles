{
  "name": "server",
  "version": "1.0.0",
  "description": "AgroHub server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup": "bun run db:generate && bun run db:migrate && bun run db:advanced",
    "db:advanced": "bun run scripts/applyAdvancedFeatures.ts",
    "db:maintenance": "bun run scripts/maintenance.ts",
    "db:maintenance:verbose": "bun run scripts/maintenance.ts --verbose"
  },
  "author": "Nyamboga Hezron",
  "license": "ISC",

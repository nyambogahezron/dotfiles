    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "formik": "^2.4.6",
    "graphql": "^16.11.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.29",
    "mongoose": "^8.15.0",
    "multer": "^1.4.5-lts.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^6.10.1",

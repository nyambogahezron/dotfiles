{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@taskflow/shared-types": ["packages/shared-types/src/index.ts"],
      "@taskflow/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@taskflow/shared-ui": ["packages/shared-ui/src/index.ts"],
      "@taskflow/shared-hooks": ["packages/shared-hooks/src/index.ts"],
      "@taskflow/shared-validations": [
        "packages/shared-validations/src/index.ts"
      ]
    }
  }
}

{
	"name": "server",
	"version": "1.0.0",
	"description": "movie diary server",
	"main": "index.ts",
	"scripts": {
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"start": "node dist/index.js",
		"dev": "nodemon index.ts",
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist coverage .turbo",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"setup": "bun install && bun run db:generate && bun run db:push"
	},
	"author": "Hezron Nyamboga",
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "^6.13.0",
		"@types/pg": "^8.15.4",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"csurf": "^1.11.0",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.44.4",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"express-validator": "^7.2.1",
		"helmet": "^8.1.0",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.1",
		"nodemailer": "^7.0.3",
		"pg": "^8.16.3",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.9.0",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/csurf": "^1.11.5",
		"@types/express": "^5.0.3",
		"@types/helmet": "^0.0.48",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^1.4.13",
		"@types/node": "^22.15.32",
		"@types/nodemailer": "^6.4.17",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.8",
		"jest": "^29.7.0",
		"nodemon": "^3.1.10",
		"prettier": "^3.6.2",
		"prisma": "6.13.0",
		"supertest": "^7.1.1",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3"
	}
}

{
  "name": "repo",
  "devDependencies": {
    "prettier": "^3.6.2",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "eslint": "^9.31.0",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "sync": "syncpack fix",
    "sync:check": "syncpack check",
    "sync:fix": "syncpack fix --write",
    "prepare": "husky install",
    "postinstall": "pnpm prepare",
    "postinstall:mobile": "turbo run postinstall --filter=@repo/mobile",
    "postinstall:web": "turbo run postinstall --filter=@repo/web",
    "postinstall:server": "turbo run postinstall --filter=@repo/server",
    "postinstall:all": "turbo run postinstall",
    "postinstall:all:mobile": "turbo run postinstall --filter=@repo/mobile",
    "postinstall:all:web": "turbo run postinstall --filter=@repo/web",
    "postinstall:all:server": "turbo run postinstall --filter=@repo/server",
    "postinstall:all:cleanup": "pnpm scripts/cleanup.sh",
    "postinstall:cleanup": "pnpm scripts/cleanup.sh",
    "precommit": "turbo run lint",
    "cleanup": "pnpm scripts/cleanup.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start:mobile": "turbo start --filter=@repo/mobile",
    "start:web": "turbo start --filter=@repo/web",
    "start:server": "turbo start --filter=@repo/server",
    "dev:mobile": "turbo dev --filter=@repo/mobile",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:server": "turbo dev --filter=@repo/server",
    "build:mobile": "turbo build --filter=@repo/mobile"
    
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,md,json,css,scss,html}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "typescript": "^5.8.3"
    }
  }
}

{
  "name": "@repo/services",
  "version": "0.0.0",
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.11.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {},
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./APIFetch": {
      "types": "./src/APIFetch.ts",
      "default": "./dist/APIFetch.js"
    },
    "./TMDBFetch": {
      "types": "./src/TMDBFetch.ts",
      "default": "./dist/TMDBFetch.js"
    },
    "./usefetch": {
      "types": "./src/usefetch.ts",
      "default": "./dist/usefetch.js"
    },
    "./queries": {
      "types": "./src/queries/index.ts",
      "default": "./dist/queries/index.js"
    },
    "./queryClient": {
      "types": "./src/queries/queryClient.ts",
      "default": "./dist/queries/queryClient.js"
    },
    "./queryWrapper": {
      "types": "./src/queries/queryWrapper.tsx",
      "default": "./dist/queries/queryWrapper.js"
    }
  },
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate:component": "turbo gen react-component",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc",
    "dev": "tsc --watch"
  }

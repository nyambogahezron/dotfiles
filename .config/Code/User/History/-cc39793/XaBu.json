{
	"name": "@repo/services",
	"version": "0.0.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"private": true,
	"scripts": {
		"check-types": "tsc --noEmit",
		"generate:component": "turbo gen react-component",
		"lint": "eslint . --max-warnings 0",
		"build": "tsc",
		"dev": "tsc --watch"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.83.0",
		"axios": "^1.11.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		
	},
	"devDependencies": {
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./APIFetch": {
			"types": "./dist/APIFetch.d.ts",
			"default": "./dist/APIFetch.js"
		},
		"./TMDBFetch": {
			"types": "./dist/TMDBFetch.d.ts",
			"default": "./dist/TMDBFetch.js"
		},
		"./usefetch": {
			"types": "./dist/usefetch.d.ts",
			"default": "./dist/usefetch.js"
		},
		"./queries": {
			"types": "./dist/queries/index.d.ts",
			"default": "./dist/queries/index.js"
		},
		"./queryClient": {
			"types": "./dist/queries/queryClient.d.ts",
			"default": "./dist/queries/queryClient.js"
		},
		"./queryWrapper": {
			"types": "./dist/queries/queryWrapper.d.ts",
			"default": "./dist/queries/queryWrapper.js"
		}
	}
	
}

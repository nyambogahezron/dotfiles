{
	"expo": {
		"name": "Task Flow",
		"slug": "taskFlow",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"scheme": "taskflow",
		"platforms": ["ios", "android", "web"],
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"associatedDomains": ["applinks:taskflow.com"]
		},
		"android": {
			"intentFilters": [
				{
					"action": "VIEW",
					"data": {
						"scheme": "https",
						"host": "taskflow.com",
						"pathPrefix": "/"
					},
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"bundler": "metro",
			"output": "single",
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router", "expo-font", "expo-router", "expo-secure-store"],
		"experiments": {
			"typedRoutes": true
		}
	}
}

                icon={Phone}
                label="Contact"
                color="bg-gradient-to-br from-emerald-500 to-emerald-700"
                onClick={() => onAppClick('contact')}
                isActive={activeApp === 'contact'}
              />
            </div>
          </div>
        </motion.div>
      </div>
    </div>
  );
}
'use client';

import { motion } from 'framer-motion';
import { StatusBar } from '@/components/ui/status-bar';
import { AppIcon } from '@/components/ui/app-icon';
import { 
  User, 
  Briefcase, 
  Phone, 
  Mail, 
  Github, 
  Linkedin,
  Settings,
  Camera
} from 'lucide-react';

interface HomeScreenProps {
  onAppClick: (app: string) => void;
  activeApp: string;
}

export function HomeScreen({ onAppClick, activeApp }: HomeScreenProps) {
  const apps = [
    { id: 'about', icon: User, label: 'About Me', color: 'bg-gradient-to-br from-blue-500 to-blue-700' },
    { id: 'projects', icon: Briefcase, label: 'My Projects', color: 'bg-gradient-to-br from-purple-500 to-purple-700' },
    { id: 'contact', icon: Phone, label: 'Call Me', color: 'bg-gradient-to-br from-green-500 to-green-700' },
    { id: 'email', icon: Mail, label: 'Email', color: 'bg-gradient-to-br from-red-500 to-red-700' },
    { id: 'github', icon: Github, label: 'GitHub', color: 'bg-gradient-to-br from-gray-600 to-gray-800' },
    { id: 'linkedin', icon: Linkedin, label: 'LinkedIn', color: 'bg-gradient-to-br from-blue-600 to-blue-800' },
    { id: 'gallery', icon: Camera, label: 'Gallery', color: 'bg-gradient-to-br from-pink-500 to-pink-700' },
    { id: 'settings', icon: Settings, label: 'Settings', color: 'bg-gradient-to-br from-gray-500 to-gray-700' },
  ];

  return (
    <div className="relative w-full h-full">
      {/* Background Wallpaper */}
      <div className="absolute inset-0 bg-gradient-to-br from-indigo-900 via-purple-900 to-pink-900">
        <div className="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.1"%3E%3Ccircle cx="30" cy="30" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-50"></div>
      </div>

      {/* Status Bar */}
      <div className="relative z-10">
        <StatusBar />
      </div>

      {/* Main Content */}
      <div className="relative z-10 flex-1 px-6 py-8">
        {/* Welcome Text */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="mb-12"
        >
          <h1 className="text-3xl font-bold text-white mb-2">
            Welcome
          </h1>
          <p className="text-white/80 text-lg">
            Mobile Developer Portfolio
          </p>
        </motion.div>

        {/* App Grid */}
        <motion.div
          initial={{ opacity: 0, y: 30 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8, delay: 0.4 }}
          className="grid grid-cols-4 gap-6"
        >
          {apps.map((app, index) => (
            <motion.div
              key={app.id}
              initial={{ opacity: 0, scale: 0.8 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ 
                duration: 0.5, 
                delay: 0.5 + index * 0.1,
                type: "spring",
                stiffness: 260,
                damping: 20
              }}
            >
              <AppIcon
                icon={app.icon}
                label={app.label}
                color={app.color}

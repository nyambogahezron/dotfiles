import React from 'react';
import { Activity, BarChart2, Film, Tv, Calendar, Star } from 'lucide-react';
import { useUserAnalytics, useWatchingStats } from '@repo/services';

const Stats: React.FC = () => {
  const {
    data: analytics,
    isLoading: analyticsLoading,
    error: analyticsError,
  } = useUserAnalytics();
  const { data: watchingStats, isLoading: statsLoading } = useWatchingStats('month');

  if (analyticsLoading || statsLoading) {
    return (
      <div className="container-custom py-16 flex justify-center">
        <div className="animate-pulse text-white">Loading statistics...</div>
      </div>
    );
  }

  if (analyticsError) {
    return (
      <div className="container-custom py-16">
        <div className="text-center">
          <h2 className="text-2xl font-bold text-white">Failed to load statistics</h2>
          <p className="text-gray-400 mt-2">{analyticsError.message}</p>
        </div>
      </div>
    );
  }

  if (!analytics) {
    return (
      <div className="container-custom py-16">
        <div className="text-center">
          <h2 className="text-2xl font-bold text-white">No statistics available</h2>
          <p className="text-gray-400 mt-2">
            Start watching movies and TV shows to see your statistics.
          </p>
        </div>
      </div>
    );
  }

  // Months for the watch history calendar
  const months = [
    'Jan',
    'Feb',
    'Mar',
    'Apr',
    'May',
    'Jun',
    'Jul',
    'Aug',
    'Sep',
    'Oct',
    'Nov',
    'Dec',
  ];

  // Create a grid for the calendar based on actual watching stats
  const createCalendarGrid = () => {
    const grid = [];

    // Create 12 months with 4 rows each (simplified)
    for (let month = 0; month < 12; month++) {
      const monthDays = [];

      // Each month has 4 weeks (simplified)
      for (let week = 0; week < 4; week++) {
        const days = [];

        // Each week has 7 days
        for (let day = 0; day < 7; day++) {
          // Use actual watching stats if available, otherwise 0
          const activity = watchingStats?.[week * 7 + day]?.count || 0;
          days.push(activity);
        }

        monthDays.push(days);
      }

      grid.push(monthDays);
    }

    return grid;
  };

  const calendarGrid = createCalendarGrid();

  return (
    <div className="container-custom py-8">
      <div className="max-w-6xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-white mb-2">Your Statistics</h1>
          <p className="text-gray-400">Track your movie and TV show watching habits</p>
        </div>

        {/* Stats Overview */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div className="bg-gray-800 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Total Watched</p>
                <p className="text-2xl font-bold text-white">{analytics.totalWatched}</p>
              </div>
              <Activity className="h-8 w-8 text-blue-400" />
            </div>
          </div>

          <div className="bg-gray-800 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Movies</p>
                <p className="text-2xl font-bold text-white">{analytics.totalMovies}</p>
              </div>
              <Film className="h-8 w-8 text-purple-400" />
            </div>
          </div>

          <div className="bg-gray-800 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">TV Shows</p>
                <p className="text-2xl font-bold text-white">{analytics.totalTVShows}</p>
              </div>
              <Tv className="h-8 w-8 text-green-400" />
            </div>
          </div>

          <div className="bg-gray-800 rounded-lg p-6">
            <div className="flex items-center justify-between">
              <div>
                <p className="text-gray-400 text-sm">Avg Rating</p>
                <p className="text-2xl font-bold text-white">
                  {analytics.averageRating.toFixed(1)}/5
                </p>
              </div>
              <Star className="h-8 w-8 text-yellow-400" />
            </div>
          </div>
        </div>

        {/* Recent Activity */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          <div className="bg-gray-800 rounded-lg p-6">
            <h2 className="text-xl font-semibold text-white mb-4 flex items-center">
              <Calendar className="mr-2 h-5 w-5 text-blue-400" />
              This Month
            </h2>
            <div className="space-y-4">
              <div className="flex justify-between items-center">
                <span className="text-gray-400">Watched</span>
                <span className="text-white font-medium">{analytics.watchedThisMonth} items</span>
              </div>
              <div className="flex justify-between items-center">
                <span className="text-gray-400">This Year</span>
                <span className="text-white font-medium">{analytics.watchedThisYear} items</span>
              </div>
            </div>
          </div>

          <div className="bg-gray-800 rounded-lg p-6">
            <h2 className="text-xl font-semibold text-white mb-4 flex items-center">
              <BarChart2 className="mr-2 h-5 w-5 text-purple-400" />
              Favorite Genres
            </h2>
            <div className="space-y-3">
              {analytics.favoriteGenres.slice(0, 5).map((genre) => (
                <div key={genre.genre} className="flex justify-between items-center">
                  <span className="text-gray-400">{genre.genre}</span>
                  <span className="text-white font-medium">{genre.count}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Watch History Calendar */}
        <div className="bg-gray-800 rounded-lg p-6">
          <h2 className="text-xl font-semibold text-white mb-6 flex items-center">
            <Calendar className="mr-2 h-5 w-5 text-green-400" />
            Watch History
          </h2>
          <div className="grid grid-cols-12 gap-4">
            {months.map((month, monthIndex) => (
              <div key={month} className="text-center">
                <h3 className="text-sm font-medium text-gray-400 mb-2">{month}</h3>
                <div className="grid grid-cols-7 gap-1">
                  {calendarGrid[monthIndex]?.flat().map((day, dayIndex) => (
                    <div
                      key={dayIndex}
                      className={`w-3 h-3 rounded-sm ${
                        day === 0
                          ? 'bg-gray-700'
                          : day === 1
                            ? 'bg-green-600'
                            : day === 2
                              ? 'bg-green-500'
                              : 'bg-green-400'
                      }`}
                      title={`${day} items watched`}
                    />
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div className="flex items-center justify-center mt-4 space-x-4 text-sm text-gray-400">
            <div className="flex items-center">
              <div className="w-3 h-3 bg-gray-700 rounded-sm mr-1" />
              <span>No activity</span>
            </div>
            <div className="flex items-center">
              <div className="w-3 h-3 bg-green-600 rounded-sm mr-1" />
              <span>1 item</span>
            </div>
            <div className="flex items-center">
              <div className="w-3 h-3 bg-green-500 rounded-sm mr-1" />
              <span>2 items</span>
            </div>
            <div className="flex items-center">
              <div className="w-3 h-3 bg-green-400 rounded-sm mr-1" />
              <span>3+ items</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default Stats;

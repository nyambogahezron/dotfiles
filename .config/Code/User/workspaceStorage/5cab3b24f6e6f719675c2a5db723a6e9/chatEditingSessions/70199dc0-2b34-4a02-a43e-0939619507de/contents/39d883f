import MediaCard from '@/components/MediaCard';
import MediaCardSkeleton from '@/components/MediaCardSkeleton';
import SearchBar from '@/components/SearchBar';
import Colors from '@/constants/Colors';
import {
  fallbackProfileImage,
  fetchMovies,
  fetchTopTreadingMovies,
  fetchTreadingTV,
  fetchUpcomingTV,
  image500,
} from '@repo/services/TMDBFetch';
import { useFetch } from '@repo/services/usefetch';
import type { Media } from '@repo/interfaces';
import { router, useLocalSearchParams } from 'expo-router';
import { Ionicons } from '@expo/vector-icons';
import { useEffect, useState } from 'react';
import { Dimensions, FlatList, Pressable, StyleSheet, Text, View } from 'react-native';

const { width } = Dimensions.get('window');

type SeeAllType = 'trending-movies' | 'upcoming-movies' | 'trending-tv' | 'upcoming-tv';

interface Movie {
  id: number;
  title?: string;
  name?: string;
  poster_path?: string;
  backdrop_path?: string;
  vote_average?: number;
  release_date?: string;
  first_air_date?: string;
  overview?: string;
}

const getTitleForType = (type: SeeAllType): string => {
  switch (type) {
    case 'trending-movies':
      return 'Trending Movies';
    case 'upcoming-movies':
      return 'Upcoming Movies';
    case 'trending-tv':
      return 'Trending TV Series';
    case 'upcoming-tv':
      return 'Upcoming TV Series';
    default:
      return 'See All';
  }
};

const getDataFetcher = (type: SeeAllType) => {
  switch (type) {
    case 'trending-movies':
      return () => fetchMovies({ query: '' });
    case 'upcoming-movies':
      return () => fetchTopTreadingMovies();
    case 'trending-tv':
      return () => fetchTreadingTV();
    case 'upcoming-tv':
      return () => fetchUpcomingTV();
    default:
      return () => fetchMovies({ query: '' });
  }
};

const getMediaType = (type: SeeAllType): 'movie' | 'tv' => {
  return type.includes('tv') ? 'tv' : 'movie';
};

export default function SeeAllScreen() {
  const { type } = useLocalSearchParams<{ type: SeeAllType }>();
  const [searchQuery, setSearchQuery] = useState('');
  const [filteredData, setFilteredData] = useState<Media[]>([]);

  const title = getTitleForType(type);
  const mediaType = getMediaType(type);
  const dataFetcher = getDataFetcher(type);

  const { data, loading, error } = useFetch(dataFetcher);

  // Transform and filter data
  useEffect(() => {
    if (data) {
      const transformedData: Media[] = data.map((item: Movie) => ({
        id: item.id,
        title: item.title || item.name || '',
        posterUrl: image500(item.poster_path) || fallbackProfileImage,
        backdropUrl: item.backdrop_path ? image500(item.backdrop_path) : undefined,
        type: mediaType,
        rating: item.vote_average || 0,
        year:
          item.release_date || item.first_air_date
            ? Number((item.release_date || item.first_air_date)!.slice(0, 4))
            : 0,
        description: item.overview,
        releaseDate: item.release_date || item.first_air_date,
      }));

      // Filter based on search query
      if (searchQuery.trim()) {
        const filtered = transformedData.filter((media) =>
          media.title.toLowerCase().includes(searchQuery.toLowerCase()),
        );
        setFilteredData(filtered);
      } else {
        setFilteredData(transformedData);
      }
    }
  }, [data, searchQuery, mediaType]);

  const renderMediaItem = ({ item, index }: { item: Media; index: number }) => (
    <View
      style={[
        styles.mediaItem,
        {
          marginRight: index % 2 === 0 ? 8 : 0,
        },
      ]}
    >
      <MediaCard
        media={item}
        type={item.type}
        style={{
          width: (width - 40) / 2,
          marginRight: 0,
        }}
      />
    </View>
  );

  if (error) {
    return (
      <View style={styles.errorContainer}>
        <Pressable style={styles.backButton} onPress={() => router.back()}>
          <ArrowLeft size={24} color={Colors.neutral[100]} />
        </Pressable>
        <Text style={styles.errorText}>Failed to load content</Text>
        <Text style={styles.errorSubtext}>{error.message}</Text>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      {/* Header */}
      <View style={styles.header}>
        <Pressable style={styles.backButton} onPress={() => router.back()}>
          <Ionicons name="arrow-back" size={24} color={Colors.neutral[100]} />
        </Pressable>
        <Text style={styles.headerTitle}>{title}</Text>
        <View style={styles.placeholder} />
      </View>

      {/* Search Bar */}
      <View style={styles.searchContainer}>
        <SearchBar
          value={searchQuery}
          onChangeText={setSearchQuery}
          placeholder={`Search ${title.toLowerCase()}...`}
          onSubmit={() => {}}
        />
      </View>

      {/* Content */}
      {loading ? (
        <View style={styles.skeletonContainer}>
          {Array.from({ length: 6 }, (_, index) => (
            <View
              key={index}
              style={[
                styles.skeletonItem,
                {
                  marginRight: index % 2 === 0 ? 8 : 0,
                },
              ]}
            >
              <MediaCardSkeleton width={(width - 40) / 2} />
            </View>
          ))}
        </View>
      ) : (
        <FlatList
          data={filteredData}
          keyExtractor={(item) => item.id.toString()}
          numColumns={2}
          renderItem={renderMediaItem}
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.listContent}
          style={styles.list}
          ListEmptyComponent={
            <View style={styles.emptyContainer}>
              <Ionicons name="search" size={48} color={Colors.neutral[600]} />
              <Text style={styles.emptyText}>
                {searchQuery.trim()
                  ? `No results found for "${searchQuery}"`
                  : `No ${title.toLowerCase()} available`}
              </Text>
            </View>
          }
        />
      )}
    </View>
  );
}


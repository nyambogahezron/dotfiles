import {
  useComments as useCommentsQuery,
  useAddComment as useAddCommentMutation,
} from '@repo/services';
import type { Comment } from '@repo/interfaces';

export function useComments({ postId }: { postId: string }) {
  const { data: commentsData, isLoading, error } = useCommentsQuery(postId);
  const addCommentMutation = useAddCommentMutation();

  const comments: Comment[] =
    commentsData?.map((comment: any) => ({
      id: comment.id,
      user: {
        id: comment.user.id,
        name: comment.user.name,
        username: comment.user.username,
        email: comment.user.email,
        avatar: comment.user.avatar,
      },
      text: comment.content,
      timeAgo: comment.createdAt ? new Date(comment.createdAt).toLocaleDateString() : 'Unknown',
    })) || [];

  const addComment = (comment: Comment) => {
    addCommentMutation.mutate({
      postId,
      content: comment.text,
    });
  };

  return {
    comments,
    loading: isLoading,
    error: error?.message || null,
    addComment,
    setComments: () => {}, // Not needed with real queries
    setLoading: () => {}, // Not needed with real queries
    setError: () => {}, // Not needed with real queries
    setAddComment: () => {}, // Not needed with real queries
  };
}

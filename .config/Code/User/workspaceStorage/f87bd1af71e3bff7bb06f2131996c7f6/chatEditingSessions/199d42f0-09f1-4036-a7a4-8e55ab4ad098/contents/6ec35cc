{
  "name": "shared-hooks",
  "version": "0.0.1",
  "sourceRoot": "src",
  "projectType": "library",
  "tags": ["shared", "hooks", "react"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared-hooks/dist",
        "main": "packages/shared-hooks/src/index.ts",
        "tsConfig": "packages/shared-hooks/tsconfig.json",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/shared-hooks/jest.config.ts"
      }
    }
  }
}

{
  "name": "shared-validations",
  "version": "0.0.1",
  "sourceRoot": "src",
  "projectType": "library",
  "tags": ["shared", "validations"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared-validations/dist",
        "main": "packages/shared-validations/src/index.ts",
        "tsConfig": "packages/shared-validations/tsconfig.json",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/shared-validations/jest.config.ts"
      }
    }
  }
}

{
	"name": "repo",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"check-types": "turbo run check-types",
		"db:generate": "turbo db:generate",
		"db:migrate": "turbo db:migrate",
		"db:studio": "turbo db:studio",
		"create-package": "bun ./scripts/create-package/index.ts",
		"dev:mobile": "turbo run dev --filter=mobile",
		"dev:web": "turbo run dev --filter=web",
		"dev:server": "turbo run dev --filter=server",
		"start:mobile": "turbo run start --filter=mobile",
		"start:web": "turbo run start --filter=web",
		"start:server": "turbo run start --filter=server",
		"build:mobile": "turbo run build --filter=mobile",
		"build:web": "turbo run build --filter=web",
		"build:server": "turbo run build --filter=server",
		"test": "turbo run test",
		"test:watch": "turbo run test -- --watch",
		"test:coverage": "turbo run test -- --coverage",
		"pre-commit": "lint-staged && bun run check-types",
		"pre-push": "bun run lint && bun run test && bun run build"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"@types/node": "^22.15.3",
		"@types/react": "19.1.0",
		"@types/react-dom": "19.1.1",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"eslint": "^9.32.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.4",
		"prettier": "^3.6.2",
		"turbo": "^2.5.4",
		"typescript": "5.8.3"
	},
	"overrides": {
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"typescript": "5.8.3",
		"tailwind-merge": "^3.3.0",
		"tailwindcss": "^3.4.17"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.2.19",
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yaml,yml}": [
			"prettier --write"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}

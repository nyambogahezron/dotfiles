@tailwind base;
@tailwind components;
@tailwind utilities;
:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* Drag and Drop Styles */
.drag-over {
  @apply bg-blue-500/10 border-blue-500/30;
}

.dragging {
  @apply opacity-50 scale-95 transform;
}

.drag-item {
  @apply cursor-move transition-all duration-200;
}

.drag-item:hover {
  @apply transform scale-105;
}

/* React Beautiful DnD Styles */
.rbd-drag-handle {
  @apply cursor-grab;
}

.rbd-drag-handle:active {
  @apply cursor-grabbing;
}

.rbd-droppable {
  @apply transition-colors duration-200;
}

.rbd-droppable.is-dragging-over {
  @apply bg-slate-700/30 border-blue-500/50;
}

import { db } from '../database/connection';
import {
  discussions,
  comments,
  users,
  projects,
  tasks,
} from '../database/schema';
import { eq, and, desc, asc, sql, isNull } from 'drizzle-orm';
import { logger } from '../utils/logger';
import { AppError } from '../utils/errors';

export class DiscussionService {
  // Create a new discussion
  static async createDiscussion(data: {
    title: string;
    content: string;
    authorId: string;
    projectId?: string;
    taskId?: string;
    parentDiscussionId?: string;
  }) {
    try {
      const [discussion] = await db
        .insert(discussions)
        .values({
          title: data.title,
          content: data.content,
          authorId: data.authorId,
          projectId: data.projectId || null,
          taskId: data.taskId || null,
          parentDiscussionId: data.parentDiscussionId || null,
        })
        .returning();

      // Fetch the discussion with author details
      const [fullDiscussion] = await db
        .select({
          id: discussions.id,
          title: discussions.title,
          content: discussions.content,
          createdAt: discussions.createdAt,
          updatedAt: discussions.updatedAt,
          projectId: discussions.projectId,
          taskId: discussions.taskId,
          parentDiscussionId: discussions.parentDiscussionId,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
        })
        .from(discussions)
        .innerJoin(users, eq(discussions.authorId, users.id))
        .where(eq(discussions.id, discussion.id))
        .limit(1);

      return fullDiscussion;
    } catch (error) {
      logger.error('Error creating discussion:', error);
      throw new AppError('Failed to create discussion', 500);
    }
  }

  // Get discussions for a project
  static async getProjectDiscussions({
    projectId,
    page = 1,
    limit = 20,
  }: {
    projectId: string;
    page?: number;
    limit?: number;
  }) {
    try {
      const offset = (page - 1) * limit;

      const discussionsList = await db
        .select({
          id: discussions.id,
          title: discussions.title,
          content: discussions.content,
          createdAt: discussions.createdAt,
          updatedAt: discussions.updatedAt,
          taskId: discussions.taskId,
          parentDiscussionId: discussions.parentDiscussionId,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
          commentsCount: sql<number>`COUNT(${comments.id})::integer`,
        })
        .from(discussions)
        .innerJoin(users, eq(discussions.authorId, users.id))
        .leftJoin(comments, eq(comments.discussionId, discussions.id))
        .where(
          and(
            eq(discussions.projectId, projectId),
            isNull(discussions.parentDiscussionId) // Only top-level discussions
          )
        )
        .groupBy(discussions.id, users.id)
        .orderBy(desc(discussions.createdAt))
        .limit(limit)
        .offset(offset);

      // Get total count
      const [countResult] = await db
        .select({ count: sql<number>`COUNT(*)::integer` })
        .from(discussions)
        .where(
          and(
            eq(discussions.projectId, projectId),
            isNull(discussions.parentDiscussionId)
          )
        );

      return {
        discussions: discussionsList,
        totalCount: countResult.count,
        page,
        limit,
        totalPages: Math.ceil(countResult.count / limit),
      };
    } catch (error) {
      logger.error('Error fetching project discussions:', error);
      throw new AppError('Failed to fetch discussions', 500);
    }
  }


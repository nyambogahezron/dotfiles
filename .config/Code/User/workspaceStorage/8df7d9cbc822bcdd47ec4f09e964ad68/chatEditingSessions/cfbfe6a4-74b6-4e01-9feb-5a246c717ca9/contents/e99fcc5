  // Get a single discussion with replies
  static async getDiscussionById(discussionId: string) {
    try {
      // Get main discussion
      const [discussion] = await db
        .select({
          id: discussions.id,
          title: discussions.title,
          content: discussions.content,
          createdAt: discussions.createdAt,
          updatedAt: discussions.updatedAt,
          projectId: discussions.projectId,
          taskId: discussions.taskId,
          parentDiscussionId: discussions.parentDiscussionId,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
        })
        .from(discussions)
        .innerJoin(users, eq(discussions.authorId, users.id))
        .where(eq(discussions.id, discussionId))
        .limit(1);

      if (!discussion) {
        throw new NotFoundError('Discussion not found');
      }

      // Get replies (nested discussions)
      const replies = await db
        .select({
          id: discussions.id,
          title: discussions.title,
          content: discussions.content,
          createdAt: discussions.createdAt,
          updatedAt: discussions.updatedAt,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
        })
        .from(discussions)
        .innerJoin(users, eq(discussions.authorId, users.id))
        .where(eq(discussions.parentDiscussionId, discussionId))
        .orderBy(asc(discussions.createdAt));

      // Get comments
      const discussionComments = await this.getDiscussionComments(discussionId);

      return {
        ...discussion,
        replies,
        comments: discussionComments.comments,
      };
    } catch (error) {
      if (error instanceof AppError) throw error;
      logger.error('Error fetching discussion:', error);
      throw new AppError('Failed to fetch discussion', 500);
    }
  }

  // Get comments for a discussion
  static async getDiscussionComments(
    discussionId: string,
    page = 1,
    limit = 50
  ) {
    try {
      const offset = (page - 1) * limit;

      const commentsWithReplies = await db
        .select({
          id: comments.id,
          content: comments.content,
          createdAt: comments.createdAt,
          updatedAt: comments.updatedAt,
          parentCommentId: comments.parentCommentId,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
        })
        .from(comments)
        .innerJoin(users, eq(comments.authorId, users.id))
        .where(eq(comments.discussionId, discussionId))
        .orderBy(asc(comments.createdAt))
        .limit(limit)
        .offset(offset);

      // Organize comments with their replies
      const commentMap = new Map();
      const topLevelComments = [];

      commentsWithReplies.forEach((comment) => {
        commentMap.set(comment.id, { ...comment, replies: [] });
      });

      commentsWithReplies.forEach((comment) => {
        if (comment.parentCommentId) {
          const parent = commentMap.get(comment.parentCommentId);
          if (parent) {
            parent.replies.push(commentMap.get(comment.id));
          }
        } else {
          topLevelComments.push(commentMap.get(comment.id));
        }
      });

      return {
        comments: topLevelComments,
        totalCount: commentsWithReplies.length,
        page,
        limit,
      };
    } catch (error) {
      logger.error('Error fetching discussion comments:', error);
      throw new AppError('Failed to fetch comments', 500);
    }
  }

  // Add a comment to a discussion
  static async addComment(data: {
    content: string;
    authorId: string;
    discussionId: string;
    parentCommentId?: string;
  }) {
    try {
      const [comment] = await db
        .insert(comments)
        .values({
          content: data.content,
          authorId: data.authorId,
          discussionId: data.discussionId,
          parentCommentId: data.parentCommentId || null,
        })
        .returning();

      // Fetch the comment with author details
      const [fullComment] = await db
        .select({
          id: comments.id,
          content: comments.content,
          createdAt: comments.createdAt,
          updatedAt: comments.updatedAt,
          parentCommentId: comments.parentCommentId,
          author: {
            id: users.id,
            firstName: users.firstName,
            lastName: users.lastName,
            email: users.email,
          },
        })
        .from(comments)
        .innerJoin(users, eq(comments.authorId, users.id))
        .where(eq(comments.id, comment.id))
        .limit(1);

      return fullComment;
    } catch (error) {
      logger.error('Error adding comment:', error);
      throw new AppError('Failed to add comment', 500);
    }
  }

  // Update a discussion
  static async updateDiscussion(
    discussionId: string,
    authorId: string,
    updates: { title?: string; content?: string }
  ) {
    try {
      // Check if user is the author
      const [existingDiscussion] = await db
        .select()
        .from(discussions)
        .where(eq(discussions.id, discussionId))
        .limit(1);

      if (!existingDiscussion) {
        throw new NotFoundError('Discussion not found');
      }

      if (existingDiscussion.authorId !== authorId) {
        throw new AppError('Not authorized to update this discussion', 403);
      }

      const [updatedDiscussion] = await db
        .update(discussions)
        .set({
          ...updates,
          updatedAt: new Date(),
        })
        .where(eq(discussions.id, discussionId))
        .returning();

      return updatedDiscussion;
    } catch (error) {
      if (error instanceof AppError) throw error;
      logger.error('Error updating discussion:', error);
      throw new AppError('Failed to update discussion', 500);
    }
  }

  // Delete a discussion
  static async deleteDiscussion(discussionId: string, authorId: string) {
    try {
      // Check if user is the author
      const [existingDiscussion] = await db
        .select()
        .from(discussions)
        .where(eq(discussions.id, discussionId))
        .limit(1);

      if (!existingDiscussion) {
        throw new NotFoundError('Discussion not found');
      }

      if (existingDiscussion.authorId !== authorId) {
        throw new AppError('Not authorized to delete this discussion', 403);
      }

      await db.delete(discussions).where(eq(discussions.id, discussionId));

      return { message: 'Discussion deleted successfully' };
    } catch (error) {
      if (error instanceof AppError) throw error;
      logger.error('Error deleting discussion:', error);
      throw new AppError('Failed to delete discussion', 500);
    }
  }

